NODE_ENV=development
PORT=5000
APP_HOST=localhost
APP_BIND_HOST=localhost
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:5173

# Production (public URLs must not include :3000 — use https://ainexus.isca.org.sg):
# NODE_ENV=production
# FRONTEND_URL=https://ainexus.isca.org.sg
# FRONTEND_URLS=https://ainexus.isca.org.sg
# OPENROUTER_APP_URL=https://ainexus.isca.org.sg
# PAYMENT_SUCCESS_URL=https://ainexus.isca.org.sg/payment-success
# PAYMENT_CANCEL_URL=https://ainexus.isca.org.sg/payment-cancel

# Core secrets
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Legacy (days only, integer): JWT_REFRESH_EXPIRES_DAYS=7
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
NRIC_DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/ai_nexus
TYPEORM_POOL_MAX=10

# SMTP
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password

# AI provider (backend only — switch without code changes)
# AI_PROVIDER=openrouter | openai | google | ollama | mock
AI_PROVIDER=openrouter
# Optional shared override for any provider:
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
AI_APP_NAME=AI Nexus
AI_APP_URL=http://localhost:3000
AI_CHATBOT_MODEL=
AI_STUDENT_MODEL=
AI_NRIC_MODEL=
AI_EXPERIENCED_MODEL=
AI_STUDENT_MAX_TOKENS=300
AI_NRIC_MAX_TOKENS=400
AI_EXPERIENCED_MAX_TOKENS=400

# OpenRouter (legacy names still supported)
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_STUDENT_MODEL=openai/gpt-4o-mini
OPENROUTER_EXPERIENCED_MODEL=openai/gpt-4o-mini
OPENROUTER_EXPERIENCED_MAX_TOKENS=400
OPENROUTER_APP_NAME=AI Nexus
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_NRIC_MAX_TOKENS=400
OPENROUTER_STUDENT_MAX_TOKENS=300

# Direct OpenAI (when AI_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google AI Studio / Gemini (when AI_PROVIDER=google)
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Ollama (when AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
NRIC_MIN_AI_CONFIDENCE=0.85

# Production safety gate:
# keep this false unless your compliance team has explicitly approved
# external AI processing for NRIC/FIN documents.
NRIC_ALLOW_EXTERNAL_AI=false
# Local/testing only: logs student OTP PIN to backend console.
STUDENT_VERIFICATION_LOG_PIN=true

# Payments
PAYMENT_SECRET_KEY=replace-with-wooshpay-secret
PAYMENT_WEBHOOK_SECRET=replace-with-wooshpay-webhook-secret
PAYMENT_WEBHOOK_VERIFY=true
PAYMENT_WEBHOOK_ACCEPT_UNVERIFIED=false
PAYMENT_SUCCESS_URL=http://localhost:3000/payment-success
PAYMENT_CANCEL_URL=http://localhost:3000/payment-cancel

# Salesforce / OAuth
OAUTH_INSTANCE_URL=https://your-instance.my.salesforce.com
OAUTH_CLIENT_ID=replace-with-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/oauth/callback
# Logout: DELETE Salesforce session (Bearer = member SSO access token)
# OAUTH_CLEAR_SESSION_PATH=/services/apexrest/v1/bodmobileapp/clearsession
# OAUTH_CLEAR_SESSION_URL=https://eservices-isca--fuat.sandbox.my.site.com/services/apexrest/v1/bodmobileapp/clearsession
# Browser SSO logout (popup on app sign-out). Default: OAUTH_INSTANCE_URL + /secur/logout.jsp
# Use the SSO host users see in the browser (e.g. eservices.isca.org.sg).
# OAUTH_BROWSER_LOGOUT_URL=https://eservices.isca.org.sg/secur/logout.jsp
# OAUTH_BROWSER_LOGOUT_PATH=/secur/logout.jsp
# Do not set OAUTH_BROWSER_LOGOUT_RET_URL — external retUrl is ignored; ISCA shows its Signin page.
# Apex REST: create Salesforce membership user before SSO (membership dialog)
OAUTH_CREATE_USER_PATH=/services/apexrest/createuserfornexus
# OAUTH_CREATE_USER_URL=https://eservices-isca--fuat.sandbox.my.site.com/services/apexrest/createuserfornexus
# Integration token for createuserfornexus (backend only — not frontend .env):
# OAUTH_INTEGRATION_ACCESS_TOKEN=
# Password grant (often via test.salesforce.com — can differ from SSO client id/secret):
# OAUTH_INTEGRATION_GRANT_TYPE=password
# OAUTH_INTEGRATION_TOKEN_URL=https://test.salesforce.com/services/oauth2/token
# OAUTH_INTEGRATION_CLIENT_ID=
# OAUTH_INTEGRATION_CLIENT_SECRET=
# OAUTH_INTEGRATION_USERNAME=
# OAUTH_INTEGRATION_PASSWORD=
# OAUTH_INTEGRATION_INSTANCE_URL=https://your-org.sandbox.my.salesforce.com
# OAUTH_CREATE_USER_URL=https://your-site.my.site.com/services/apexrest/createuserfornexus
# OAUTH_SET_PASSWORD_URL=https://your-site.my.site.com/services/apexrest/setpasswordfornexus
# Student membership application API (member SSO token) — routes in src/config/oauth-student-membership-api.config.ts
# OAUTH_STUDENT_MEMBERSHIP_API_BASE_PATH=/services/apexrest/api/student-membership
# OAUTH_STUDENT_MEMBERSHIP_APPLICATION_URL=https://eservices-isca--fuat.sandbox.my.site.com/services/apexrest/api/student-membership/application

# Membership application API (member SSO token) — routes in src/config/oauth-application-api.config.ts
# URLs = OAUTH_INSTANCE_URL + OAUTH_APPLICATION_API_BASE_PATH + route segment
# OAUTH_APPLICATION_API_BASE_PATH=/services/apexrest/mobileAPI/v1/ApplicationAPI
# Optional per-route segment override, e.g. OAUTH_APPLICATION_API_ROUTE_CREATE=createApplicationNexus
# Document upload: getAvailableDocumentTypesNexus (GET), uploadDocumentNexus (POST)
# OAUTH_APPLICATION_API_ROUTE_AVAILABLE_DOCUMENT_TYPES=getAvailableDocumentTypesNexus
# OAUTH_APPLICATION_API_ROUTE_UPLOAD_DOCUMENT=uploadDocumentNexus
# Billing: createBillingNexus (POST)
# OAUTH_APPLICATION_API_ROUTE_CREATE_BILLING=createBillingNexus
# Membership application WooshPay checkout placeholder user id (UUID in users table)
# MEMBERSHIP_APPLICATION_PAYMENT_USER_ID=00000000-0000-4000-8000-000000000001
# MEMBERSHIP_APPLICATION_FEE_SGD=900
# SCAQ SSO: POST .../memberclassupdate?accountId=001xxx when isAssociateMember is false
# Uses OAUTH_INTEGRATION_* admin token (not the end-user SSO token).
# OAUTH_MEMBER_CLASS_UPDATE_URL=https://your-site.my.site.com/services/apexrest/memberclassupdate
# PATCH isAINexusUser=true after successful platform SSO login (integration token).
# OAUTH_AI_NEXUS_USER_ACCOUNT_UPDATE_URL=https://eservices-isca.my.salesforce.com/services/apexrest/accountupdate/ai-nexus-user
NODE_ENV=development
PORT=5000
APP_HOST=localhost
APP_BIND_HOST=localhost

# PostgreSQL connection for local/pgAdmin-managed database
DATABASE_URL=postgresql://postgres:root@localhost:5432/ainexus-db
TYPEORM_POOL_MAX=10

# JWT signing secret for backend auth
JWT_SECRET=replace_with_strong_secret

# Frontend/CORS
FRONTEND_URL=http://localhost:3030
FRONTEND_URLS=http://localhost:3030,http://localhost:3000
CORS_EXTRA_ORIGINS=

# Spotlightr course section videos (when SPOTLIGHTR_API_KEY is set, uploads use Spotlightr instead of local disk)
# SPOTLIGHTR_HLS=0 → MP4 playback, no .m3u8.key calls. SPOTLIGHTR_HLS=1 → encrypted HLS (key per segment).
# Player bar (play, time, speed, volume): Spotlightr dashboard → Theme → Player Settings → Playback Speed ON
SPOTLIGHTR_API_KEY=dashjk4hjk32hkfdss234kkhjas
SPOTLIGHTR_VIDEO_GROUP=Njg4NDk
SPOTLIGHTR_CUSTOM_S3=0
SPOTLIGHTR_HLS=0
SPOTLIGHTR_UPLOAD_TIMEOUT_MS=600000

# Flowise bridge (AI resource templates — use API port 3002, not UI port 3001)
# FLOWISE_INTERNAL_URL=http://localhost:3002
# FLOWISE_PORT=3002

