<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS / ARR reverse proxy in front of the Nest API.
     Place in the IIS site root that proxies to https://localhost:5000.
     IIS maxAllowedContentLength is per-request; max ~4 GB (4294967295 bytes).
     For videos larger than 4 GB, use direct storage upload (S3) or nginx instead of IIS. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- ~4 GB (IIS maximum for this setting) -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <proxy enabled="true" timeout="00:60:00" />
    <aspNetCore requestTimeout="01:00:00" />
  </system.webServer>
</configuration>
