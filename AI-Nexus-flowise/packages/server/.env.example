NODE_ENV=production
HOST=0.0.0.0
PORT=3002

# Public UI origin (redirect target after external-login)
APP_URL=https://flowise.ainexusuat.isca.org.sg

# Public API origin is api.flowise.ainexusuat (nginx → :3002)
# Share cookies with UI host (parent of both flowise.* and api.flowise.*)
COOKIE_DOMAIN=.flowise.ainexusuat.isca.org.sg

AI_NEXUS_API_URL=https://api.ainexusuat.isca.org.sg/api
EXTERNAL_AUTH_API_URL=https://api.ainexusuat.isca.org.sg/api

SCHEME=https

# Prefer TLS at nginx; set false when proxy_pass is http://127.0.0.1:3002
SSL_ENABLED=false
# SSL_KEY_PATH=ssl/ainexusuat.isca.org.sg-key.pem
# SSL_CERT_PATH=ssl/ainexusuat.isca.org.sg-chain.pem

FLOWISE_TOKEN_ONLY_AUTH=true
AINEXUS_JWT_SECRET=replace-with-jwt-secret

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flowise
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-db-password

CORS_ORIGINS=https://flowise.ainexusuat.isca.org.sg,https://api.flowise.ainexusuat.isca.org.sg,https://ainexusuat.isca.org.sg
CORS_ALLOW_CREDENTIALS=true
IFRAME_ORIGINS=https://ainexusuat.isca.org.sg

# ---- Memory / execution limits (Chatflows + Agentflows) ----
# Node heap (also set via start:prod scripts)
# NODE_OPTIONS=--max-old-space-size=4096
# Agentflow v2 max node steps per prediction (default 50; was 1000)
MAX_ITERATIONS=50
# Loop node re-queue ceiling (default 5; was 10)
MAX_LOOP_COUNT=5
# Past messages loaded into Agentflow (default 40; was unlimited)
AGENTFLOW_HISTORY_LIMIT=40
# Agent recursive tool-call rounds (default 8)
AGENT_MAX_TOOL_ROUNDS=8
# In-memory LLM/embedding/MCP cache entries (default 50)
CACHE_POOL_MAX_ENTRIES=50
# Redis TTL for caches when MODE=queue (seconds)
CACHE_POOL_REDIS_TTL_SEC=3600
# Queue worker concurrency if MODE=queue (default 5; was 100000)
WORKER_CONCURRENCY=5
