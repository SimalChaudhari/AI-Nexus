# ----------------------------------------------------------------------
# AI-Nexus Frontend – copy to .env and fill in values
# Vite exposes only variables that start with VITE_
# ----------------------------------------------------------------------

# Backend API base URL (required for login, SSO, and all API calls)
# Must include /api at the end. Leave empty to use default.
VITE_SERVER_URL=http://localhost:3000/api

# Optional: if the app is served under a subpath (e.g. /app)
VITE_BASE_PATH=

# Optional: static assets base URL
VITE_ASSET_URL=

# ----------------------------------------------------------------------
# SSO: no frontend env needed for SSO itself.
# Backend .env must set MOBILE_DEEP_LINK_SCHEME to this app’s callback URL, e.g.:
#   Development: http://localhost:5173/auth/oauth/callback
#   Production:  https://your-domain.com/auth/oauth/callback
# ----------------------------------------------------------------------

# Optional: WebSockets (set to false if backend is serverless, e.g. Vercel)
# VITE_SOCKET_ENABLED=true

# Optional: Payment (WooshPay public key for embedded checkout)
# VITE_PAYMENT_PUBLIC_KEY=
