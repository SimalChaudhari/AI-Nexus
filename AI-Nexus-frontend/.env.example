# ----------------------------------------------------------------------
# AI-Nexus Frontend – copy to .env and fill in values
# Vite exposes only variables that start with VITE_
# ----------------------------------------------------------------------

# Backend API base URL (must include /api). Development:
VITE_SERVER_URL=http://localhost:5000/api

# Production — API on port 5000, SPA on 443 (pick one):
# VITE_SERVER_URL=https://ainexus.isca.org.sg:5000/api
# Or only set the port (hostname taken from the page):
# VITE_API_PORT=5000
# Alternative: same-origin /api via nginx proxy on 443 (omit both vars above)

# Optional: if the app is served under a subpath (e.g. /app)
VITE_BASE_PATH=

# Optional: static assets base URL
VITE_ASSET_URL=

# ----------------------------------------------------------------------
# SSO: no frontend env needed for SSO itself.
# Backend .env must set MOBILE_DEEP_LINK_SCHEME to this app’s callback URL, e.g.:
#   Development: http://localhost:5173/auth/oauth/callback
#   Production:  https://your-domain.com/auth/oauth/callback
# ----------------------------------------------------------------------

# Optional: WebSockets (set to false if backend is serverless, e.g. Vercel)
# VITE_SOCKET_ENABLED=true

# Optional: Payment (WooshPay public key for embedded checkout)
# VITE_PAYMENT_PUBLIC_KEY=

# Home “Get Started Now” → pathway links (defaults + specialisation Yes/No overrides)
# VITE_HOME_ASSOCIATE_ESERVICES_SIGNUP_URL=https://www.google.com
# VITE_HOME_ASSOCIATE_PATHWAY_PAGE_URL=https://isca.org.sg/membership/become-a-member/individual-membership/specialisation-pathways
# VITE_HOME_READ_PATHWAY_PAGE_URL=https://isca.org.sg/membership/become-a-member/individual-membership/specialisation-pathways
# Specialisation Yes — application portal + “Associate Pathway” explore link
# VITE_HOME_SPEC_YES_APPLICATION_URL=https://www.google.com
# VITE_HOME_SPEC_YES_ASSOCIATE_PATHWAY_URL=https://www.google.com
# Specialisation No — eServices, “ISCA PBA” explore card, “Read the pathway page” button
# VITE_HOME_SPEC_NO_APPLICATION_URL=https://eservices.isca.org.sg
# VITE_HOME_SPEC_NO_PBA_PATHWAY_URL=https://isca.org.sg/membership/become-a-member/individual-membership/professional-business-accountant-pathway
# VITE_HOME_SPEC_NO_READ_PATHWAY_URL=https://isca.org.sg/membership/become-a-member/individual-membership/associate-pathway
# Student eligibility (home Get Started) — “Read the pathway page” button
# VITE_HOME_STUDENT_READ_PATHWAY_URL=https://isca.org.sg/membership/StudentMember
# VITE_HOME_STUDENT_ESERVICES_SIGNUP_URL=https://eservices.isca.org.sg
# Experienced pathway — specialisation No
# VITE_HOME_EXP_NO_APPLICATION_URL=https://eservices.isca.org.sg
# VITE_HOME_EXP_NO_ASSOCIATE_PATHWAY_URL=https://isca.org.sg/membership/become-a-member/individual-membership/associate-pathway
# VITE_HOME_EXP_NO_READ_PATHWAY_URL=https://isca.org.sg/membership/become-a-member/individual-membership/associate-pathway

# ----------------------------------------------------------------------
# Flowise (browser redirects, bridge, template preview)
# Use EITHER a full public URL OR a path on the same host (recommended behind nginx TLS).
# Do not point VITE_FLOWISE_URL at https://host:3002 unless Node actually serves HTTPS on 3002.
# ----------------------------------------------------------------------
# VITE_FLOWISE_URL=http://localhost:3001
# Production same-origin proxy example: leave VITE_FLOWISE_URL empty and set:
# VITE_FLOWISE_RELATIVE_PATH=/flowise
